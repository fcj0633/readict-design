{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["scripts/browser-*.js"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["buttonVariants", "tabsListVariants", "useStore"] }]
  }
}
